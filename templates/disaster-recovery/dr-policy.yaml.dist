# ==============================================================================
# Symfony Engineering Agent — Enterprise Disaster Recovery (DR) Policy
# RTO & RPO SLA Budgets, Multi-Region Topology, and Failover Orchestration
# ==============================================================================

version: "1.0.0"
scope: "enterprise-production"

# Service Level Agreements (SLA) & Recovery Objectives
objectives:
  tier_1:
    description: "Core Customer-Facing API, Authentication & Checkout"
    rto_seconds: 300   # Recovery Time Objective: Max 5 minutes to restore service
    rpo_seconds: 60    # Recovery Point Objective: Max 1 minute of data loss tolerance
    replication: "synchronous_or_streaming_wal"

  tier_2:
    description: "Asynchronous Workers, Reporting & Non-Critical Backoffice"
    rto_seconds: 3600  # Recovery Time Objective: Max 1 hour
    rpo_seconds: 900   # Recovery Point Objective: Max 15 minutes of data loss
    replication: "asynchronous"

# Multi-Region Topologies
topology:
  strategy: "active_passive_hot_standby" # Options: active_passive_hot_standby, active_active_multi_primary
  primary_region:
    name: "primary-sa-east"
    location: "sa-east-1"
    role: "active_read_write"
    database_endpoint: "postgresql-primary.internal.local:5432"

  standby_region:
    name: "standby-us-east"
    location: "us-east-1"
    role: "hot_standby_read_replica"
    database_endpoint: "postgresql-standby.internal.local:5432"
    replication_lag_threshold_seconds: 30

# Automated Failover Governance & Trigger Conditions
failover:
  automation_mode: "semi_automated" # 'fully_automated' with quorum or 'semi_automated' with operator confirmation
  health_checks:
    endpoint: "/up"
    interval_seconds: 5
    consecutive_failures_threshold: 3
    timeout_seconds: 2

  triggers:
    - primary_region_unreachable
    - database_cluster_quorum_loss
    - replication_lag_exceeded

  dns_failover:
    provider: "route53_or_cloudflare"
    ttl_seconds: 60
    health_check_id: "hc-symfony-production-sa-east"

# Backup Integrity & Continuous Verification Schedule
backups:
  retention:
    daily_full_days: 30
    monthly_archive_days: 365
    wal_continuous_days: 7
  storage:
    primary_bucket: "s3://symfony-backups-primary-sa-east"
    cross_region_mirror_bucket: "s3://symfony-backups-mirror-us-east"
    encryption: "aws:kms"
  verification:
    automated_drill_schedule: "0 3 * * *" # Daily at 03:00 UTC
    validation_script: "templates/disaster-recovery/backup-verification.sh"
