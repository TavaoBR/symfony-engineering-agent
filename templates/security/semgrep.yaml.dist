rules:
  # ============================================================================
  # 1. SQL Injection via String Concatenation in Doctrine QueryBuilder
  # ============================================================================
  - id: symfony-doctrine-sqli-concatenation
    languages: [php]
    severity: ERROR
    message: >-
      Potential SQL/DQL Injection detected in Doctrine QueryBuilder.
      Avoid concatenating variables directly into where conditions. Use bound parameters instead (e.g. ->setParameter('id', $id)).
    metadata:
      cwe: "CWE-89: Improper Neutralization of Special Elements used in an SQL Command"
      owasp: "A03:2021 - Injection"
      category: security
      confidence: HIGH
    patterns:
      - pattern-either:
          - pattern: $QB->where(... . $VAR . ...)
          - pattern: $QB->andWhere(... . $VAR . ...)
          - pattern: $QB->orWhere(... . $VAR . ...)
          - pattern: $EM->createQuery(... . $VAR . ...)

  # ============================================================================
  # 2. Insecure Deserialization via Native unserialize()
  # ============================================================================
  - id: php-insecure-unserialize
    languages: [php]
    severity: ERROR
    message: >-
      Unsafe call to native unserialize() detected.
      Deserializing untrusted input can result in Remote Code Execution (RCE) via PHP object injection.
      Use JSON format (json_decode) or specify ['allowed_classes' => false].
    metadata:
      cwe: "CWE-502: Deserialization of Untrusted Data"
      owasp: "A08:2021 - Software and Data Integrity Failures"
      category: security
      confidence: HIGH
    pattern: unserialize(...)

  # ============================================================================
  # 3. Command Injection via Shell Execution
  # ============================================================================
  - id: php-command-injection
    languages: [php]
    severity: ERROR
    message: >-
      Command execution using dynamic variables detected.
      Passing user-controllable input to shell execution functions leads to Command Injection.
      Use Symfony Process component with arguments passed as an array.
    metadata:
      cwe: "CWE-78: Improper Neutralization of Special Elements used in an OS Command"
      owasp: "A03:2021 - Injection"
      category: security
      confidence: HIGH
    patterns:
      - pattern-either:
          - pattern: exec(... . $VAR . ...)
          - pattern: shell_exec(... . $VAR . ...)
          - pattern: system(... . $VAR . ...)
          - pattern: passthru(... . $VAR . ...)

  # ============================================================================
  # 4. Path Traversal in File System Operations
  # ============================================================================
  - id: php-path-traversal-input
    languages: [php]
    severity: ERROR
    message: >-
      Potential Path Traversal in file system operation.
      Directly using request input or concatenated variables in file operations allows attackers to access arbitrary files.
      Sanitize inputs using basename() and validate against an allowed directory prefix.
    metadata:
      cwe: "CWE-22: Improper Limitation of a Pathname to a Restricted Directory"
      owasp: "A01:2021 - Broken Access Control"
      category: security
      confidence: MEDIUM
    patterns:
      - pattern-either:
          - pattern: file_get_contents(... . $REQUEST->... . ...)
          - pattern: unlink(... . $REQUEST->... . ...)
          - pattern: readfile(... . $REQUEST->... . ...)
          - pattern: fopen(... . $REQUEST->... . ...)

  # ============================================================================
  # 5. Open Redirect via Untrusted User Input
  # ============================================================================
  - id: symfony-open-redirect
    languages: [php]
    severity: WARNING
    message: >-
      Potential Open Redirect vulnerability.
      Redirecting directly to user-supplied query parameters allows attackers to construct phishing links under your domain.
      Validate URLs against an internal domain whitelist before redirecting.
    metadata:
      cwe: "CWE-601: URL Redirection to Untrusted Site"
      owasp: "A01:2021 - Broken Access Control"
      category: security
      confidence: MEDIUM
    patterns:
      - pattern-either:
          - pattern: $THIS->redirect($REQUEST->query->get(...))
          - pattern: $THIS->redirect($REQUEST->get(...))

  # ============================================================================
  # 6. Hardcoded Secrets and Credentials
  # ============================================================================
  - id: php-hardcoded-secret-token
    languages: [php]
    severity: ERROR
    message: >-
      Possible hardcoded secret or token detected.
      Secrets must be loaded via Symfony environment variables (%env(...)%) or secret vaults.
    metadata:
      cwe: "CWE-798: Use of Hard-coded Credentials"
      owasp: "A07:2021 - Identification and Authentication Failures"
      category: security
      confidence: MEDIUM
    patterns:
      - pattern-regex: "(?i)(api[_-]?key|secret[_-]?key|password|bearer|auth[_-]?token)\\s*=\\s*['\"][a-zA-Z0-9_\\-]{16,}['\"]"
