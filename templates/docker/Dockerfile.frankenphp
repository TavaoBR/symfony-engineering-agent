# syntax=docker/dockerfile:1.4
# ==============================================================================
# Symfony Engineering Agent — Multi-Stage FrankenPHP Dockerfile
# Optimized for Symfony 6.4 LTS / 7.x+ on PHP 8.2 / 8.3
# Features: Caddy Server, HTTP/3, Worker Mode, OPcache Preload, Non-Root Hardening
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Base Runtime Environment
# ------------------------------------------------------------------------------
FROM dunglas/frankenphp:1-php8.3-bookworm AS base

ARG DEBIAN_FRONTEND=noninteractive

# System dependencies & PHP extension build libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    acl \
    file \
    gettext \
    git \
    libicu-dev \
    libpq-dev \
    libzip-dev \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install official PHP extensions via install-php-extensions
RUN install-php-extensions \
    apcu \
    intl \
    opcache \
    pdo_pgsql \
    pdo_mysql \
    redis \
    zip

# Configure default PHP production runtime parameters
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" && \
    sed -i -e "s/expose_php = On/expose_php = Off/g" "$PHP_INI_DIR/php.ini" && \
    sed -i -e "s/memory_limit = 128M/memory_limit = 256M/g" "$PHP_INI_DIR/php.ini" && \
    sed -i -e "s/max_execution_time = 30/max_execution_time = 60/g" "$PHP_INI_DIR/php.ini"

# OPcache & JIT high-performance tuning
RUN echo "opcache.enable=1" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini" && \
    echo "opcache.enable_cli=1" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini" && \
    echo "opcache.memory_consumption=256" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini" && \
    echo "opcache.interned_strings_buffer=16" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini" && \
    echo "opcache.max_accelerated_files=20000" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini" && \
    echo "opcache.validate_timestamps=0" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini" && \
    echo "opcache.revalidate_freq=0" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini"

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

WORKDIR /app

# Copy custom Caddyfile configuration
COPY templates/docker/Caddyfile.dist /etc/caddy/Caddyfile
COPY templates/docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint
RUN chmod +x /usr/local/bin/docker-entrypoint

ENTRYPOINT ["docker-entrypoint"]
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]

# ------------------------------------------------------------------------------
# Stage 2: Vendor & Asset Dependency Builder
# ------------------------------------------------------------------------------
FROM base AS builder

ENV APP_ENV=prod
ENV COMPOSER_ALLOW_SUPERUSER=1

# Copy Composer specifications first for layer caching
COPY composer.json composer.lock symfony.lock* ./

# Install production dependencies without running scripts
RUN composer install --no-dev --prefer-dist --no-progress --no-interaction --optimize-autoloader --no-scripts

# Copy complete application source code
COPY . .

# Run post-install Composer scripts and generate optimized authoritative classmap
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev && \
    composer dump-env prod --empty || true

# Pre-compile and warm up Symfony production cache
RUN if [ -f "bin/console" ]; then \
        php bin/console cache:warmup --no-debug || true; \
    fi

# ------------------------------------------------------------------------------
# Stage 3: Development Target (Xdebug, Debugger, Dev Worker)
# ------------------------------------------------------------------------------
FROM base AS dev

ENV APP_ENV=dev
ENV APP_DEBUG=1

# Install development extensions (Xdebug)
RUN install-php-extensions xdebug

# Configure Xdebug for containerized environments
RUN echo "xdebug.mode=debug,develop" >> "$PHP_INI_DIR/conf.d/docker-php-ext-xdebug.ini" && \
    echo "xdebug.start_with_request=trigger" >> "$PHP_INI_DIR/conf.d/docker-php-ext-xdebug.ini" && \
    echo "xdebug.client_host=host.docker.internal" >> "$PHP_INI_DIR/conf.d/docker-php-ext-xdebug.ini" && \
    echo "xdebug.client_port=9003" >> "$PHP_INI_DIR/conf.d/docker-php-ext-xdebug.ini"

# Re-enable OPcache timestamp revalidation for live file changes in dev
RUN sed -i -e "s/opcache.validate_timestamps=0/opcache.validate_timestamps=1/g" "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini"

USER root
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile", "--watch"]

# ------------------------------------------------------------------------------
# Stage 4: Hardened Production Target
# ------------------------------------------------------------------------------
FROM base AS prod

ENV APP_ENV=prod
ENV APP_DEBUG=0

# Configure OPcache preloading
RUN if [ -f "/app/config/preload.php" ]; then \
        echo "opcache.preload=/app/config/preload.php" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini" && \
        echo "opcache.preload_user=www-data" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini"; \
    fi

# Copy built vendor, assets, and warmed cache from builder stage
COPY --from=builder /app /app

# Ensure correct permissions for unprivileged www-data user
RUN chown -R www-data:www-data /app/var /app/public && \
    chmod -R 775 /app/var

# Healthcheck validating HTTP server responsiveness
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:80/up || exit 1

# Execute container as unprivileged www-data user
USER www-data

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
