# syntax=docker/dockerfile:1.4
# ==============================================================================
# Symfony Engineering Agent — Multi-Stage PHP-FPM Dockerfile
# Optimized for Symfony 6.4 LTS / 7.x+ on PHP 8.2 / 8.3
# Features: Multi-stage, OPcache Preloading, Non-root execution, Healthchecks
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Base Runtime Environment
# ------------------------------------------------------------------------------
FROM php:8.3-fpm-bookworm AS base

ARG DEBIAN_FRONTEND=noninteractive

# System dependencies & build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    acl \
    file \
    git \
    libicu-dev \
    libpq-dev \
    libzip-dev \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install official PHP extensions
ADD --chmod=0755 https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/

RUN install-php-extensions \
    apcu \
    intl \
    opcache \
    pdo_pgsql \
    pdo_mysql \
    redis \
    zip

# Production PHP settings
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" && \
    sed -i -e "s/expose_php = On/expose_php = Off/g" "$PHP_INI_DIR/php.ini" && \
    sed -i -e "s/memory_limit = 128M/memory_limit = 256M/g" "$PHP_INI_DIR/php.ini"

# OPcache tuning
RUN echo "opcache.enable=1" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini" && \
    echo "opcache.memory_consumption=256" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini" && \
    echo "opcache.interned_strings_buffer=16" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini" && \
    echo "opcache.max_accelerated_files=20000" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini" && \
    echo "opcache.validate_timestamps=0" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini"

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

WORKDIR /app

COPY templates/docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint
RUN chmod +x /usr/local/bin/docker-entrypoint

ENTRYPOINT ["docker-entrypoint"]
CMD ["php-fpm"]

# ------------------------------------------------------------------------------
# Stage 2: Vendor & Asset Dependency Builder
# ------------------------------------------------------------------------------
FROM base AS builder

ENV APP_ENV=prod
ENV COMPOSER_ALLOW_SUPERUSER=1

COPY composer.json composer.lock symfony.lock* ./
RUN composer install --no-dev --prefer-dist --no-progress --no-interaction --optimize-autoloader --no-scripts

COPY . .

RUN composer dump-autoload --optimize --classmap-authoritative --no-dev && \
    composer dump-env prod --empty || true

RUN if [ -f "bin/console" ]; then \
        php bin/console cache:warmup --no-debug || true; \
    fi

# ------------------------------------------------------------------------------
# Stage 3: Development Target
# ------------------------------------------------------------------------------
FROM base AS dev

ENV APP_ENV=dev
ENV APP_DEBUG=1

RUN install-php-extensions xdebug

RUN sed -i -e "s/opcache.validate_timestamps=0/opcache.validate_timestamps=1/g" "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini"

USER root
CMD ["php-fpm"]

# ------------------------------------------------------------------------------
# Stage 4: Hardened Production Target
# ------------------------------------------------------------------------------
FROM base AS prod

ENV APP_ENV=prod
ENV APP_DEBUG=0

RUN if [ -f "/app/config/preload.php" ]; then \
        echo "opcache.preload=/app/config/preload.php" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini" && \
        echo "opcache.preload_user=www-data" >> "$PHP_INI_DIR/conf.d/docker-php-ext-opcache.ini"; \
    fi

COPY --from=builder /app /app

RUN chown -R www-data:www-data /app/var /app/public && \
    chmod -R 775 /app/var

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD cgi-fcgi -bind -connect 127.0.0.1:9000 || exit 1

USER www-data

CMD ["php-fpm"]
